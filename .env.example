# Secure IoT Device Platform - example configuration
# A real .env is generated automatically on the first start.

APP_NAME="IoT Device Platform"
ENVIRONMENT=development
LOG_LEVEL=INFO

# Web dashboard credentials. setup.py generates a random password.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=CHANGE_THIS_PASSWORD

# Fernet key used to encrypt bootstrap secrets in SQLite.
# setup.py generates a valid key automatically.
BOOTSTRAP_MASTER_KEY=REPLACE_WITH_A_FERNET_KEY

DATABASE_URL=sqlite:////data/iot_device_platform.db
CHALLENGE_TTL_SECONDS=120
CERT_VALIDITY_DAYS=365
ONLINE_TIMEOUT_SECONDS=90
ALLOW_REPROVISIONING=false

# Device-facing network selection.
# The full launcher automatically uses ONLY the active physical Wi-Fi IPv4
# of the host PC. Ethernet, Docker, WSL, VPN and virtual adapters are ignored.
NETWORK_INTERFACE_MODE=wifi
AUTO_NETWORK_SYNC=true
API_PUBLIC_HOST=192.168.50.10
API_PUBLIC_PORT=8443
MQTT_PUBLIC_HOST=192.168.50.10
MQTT_PUBLIC_PORT=8883

# Plain HTTP transport carrying an ECDSA-signed time token. This service is
# intentionally independent of TLS so an ESP32 without RTC/NTP can establish
# a trusted clock before validating the API and broker X.509 certificates.
TIME_PUBLIC_PORT=8091
TIME_SIGNING_KEY_PATH=/pki/time/time-signing.key
SERVER_HOSTNAME=localhost

# Internal API-to-broker connection inside Docker Compose.
MQTT_ENABLED=true
MQTT_HOST=broker
MQTT_PORT=8883

# Common Wi-Fi embedded temporarily into physical ESP32 firmware builds.
# install-platform.bat asks for these values during first setup and full startup
# can update them later. Password input is hidden and stored only in local .env.
IOT_WIFI_SSID=
IOT_WIFI_PASSWORD=

SIMULATOR_MANAGER_URL=http://simulator-manager:8090

# Host-side ESP32 manufacturing station.
MANUFACTURING_ENABLED=true
MANUFACTURING_AGENT_URL=http://host.docker.internal:8765
MANUFACTURING_AGENT_TOKEN=
MANUFACTURING_AGENT_TIMEOUT_SECONDS=900

CA_CERT_PATH=/pki/ca/ca.crt
CA_KEY_PATH=/pki/ca/ca.key
SERVER_CERT_PATH=/pki/api/api.crt
SERVER_KEY_PATH=/pki/api/api.key
MQTT_CA_PATH=/pki/ca/ca.crt
MQTT_CLIENT_CERT_PATH=/pki/control/control.crt
MQTT_CLIENT_KEY_PATH=/pki/control/control.key
CRL_PATH=/pki/crl/ca.crl
